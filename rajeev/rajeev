  <script src="script.js"></script>
  <script>
    /**
 * Electronics Engineer Portfolio JavaScript
 * Engine & Animations Controller
 */

document.addEventListener('DOMContentLoaded', () => {

  /* ==========================================================================
     1. THEME SWITCHER & LOCAL STORAGE
     ========================================================================== */
  const themeToggleBtn = document.getElementById('theme-toggle');
  const htmlTag = document.documentElement;

  // Saved theme or system default
  const savedTheme = localStorage.getItem('theme') || 
    (window.matchMedia('(prefers-color-scheme: light)').matches ? 'light' : 'dark');

  htmlTag.setAttribute('data-theme', savedTheme);

  themeToggleBtn.addEventListener('click', () => {
    const currentTheme = htmlTag.getAttribute('data-theme');
    const newTheme = currentTheme === 'dark' ? 'light' : 'dark';
    htmlTag.setAttribute('data-theme', newTheme);
    localStorage.setItem('theme', newTheme);
  });

  /* ==========================================================================
     2. MOBILE NAVIGATION HAMBURGER
     ========================================================================== */
  const hamburger = document.getElementById('hamburger');
  const navLinks = document.getElementById('nav-links');
  const navLinkItems = document.querySelectorAll('.nav-link');

  hamburger.addEventListener('click', () => {
    hamburger.classList.toggle('active');
    navLinks.classList.toggle('open');
    const expanded = hamburger.getAttribute('aria-expanded') === 'true' || false;
    hamburger.setAttribute('aria-expanded', !expanded);
  });

  navLinkItems.forEach(item => {
    item.addEventListener('click', () => {
      hamburger.classList.remove('active');
      navLinks.classList.remove('open');
      hamburger.setAttribute('aria-expanded', false);
    });
  });

  /* ==========================================================================
     3. TYPING EFFECT IN HERO SECTION
     ========================================================================== */
  const typingText = document.getElementById('typing-text');
  const phrases = [
    'Electronics Engineer',
    'Embedded Systems Developer',
    'IoT Architect & Hardware Designer',
    'PCB & Signal Integrity Engineer'
  ];
  let phraseIdx = 0;
  let charIdx = 0;
  let isDeleting = false;

  function typeEffect() {
    const currentPhrase = phrases[phraseIdx];

    if (isDeleting) {
      typingText.textContent = currentPhrase.substring(0, charIdx - 1);
      charIdx--;
    } else {
      typingText.textContent = currentPhrase.substring(0, charIdx + 1);
      charIdx++;
    }

    let speed = isDeleting ? 40 : 80;

    if (!isDeleting && charIdx === currentPhrase.length) {
      speed = 2000; // Pause at end
      isDeleting = true;
    } else if (isDeleting && charIdx === 0) {
      isDeleting = false;
      phraseIdx = (phraseIdx + 1) % phrases.length;
      speed = 500;
    }

    setTimeout(typeEffect, speed);
  }

  typeEffect();

  /* ==========================================================================
     4. INTERACTIVE PCB CIRCUIT CANVAS BACKGROUND
     ========================================================================== */
  const canvas = document.getElementById('circuit-bg');
  const ctx = canvas.getContext('2d');

  function resizeCanvas() {
    canvas.width = window.innerWidth;
    canvas.height = window.innerHeight;
  }

  window.addEventListener('resize', resizeCanvas);
  resizeCanvas();

  const nodes = [];
  const nodeCount = Math.floor(window.innerWidth / 35);

  for (let i = 0; i < nodeCount; i++) {
    nodes.push({
      x: Math.random() * canvas.width,
      y: Math.random() * canvas.height,
      vx: (Math.random() - 0.5) * 0.5,
      vy: (Math.random() - 0.5) * 0.5,
      radius: Math.random() * 2 + 1
    });
  }

  function drawCircuit() {
    ctx.clearRect(0, 0, canvas.width, canvas.height);
    const isDark = htmlTag.getAttribute('data-theme') === 'dark';
    const strokeColor = isDark ? 'rgba(0, 240, 255, 0.12)' : 'rgba(2, 132, 199, 0.12)';
    const nodeColor = isDark ? 'rgba(0, 240, 255, 0.4)' : 'rgba(2, 132, 199, 0.4)';

    ctx.strokeStyle = strokeColor;
    ctx.fillStyle = nodeColor;
    ctx.lineWidth = 1;

    for (let i = 0; i < nodes.length; i++) {
      const node = nodes[i];

      node.x += node.vx;
      node.y += node.vy;

      if (node.x < 0 || node.x > canvas.width) node.vx *= -1;
      if (node.y < 0 || node.y > canvas.height) node.vy *= -1;

      ctx.beginPath();
      ctx.arc(node.x, node.y, node.radius, 0, Math.PI * 2);
      ctx.fill();

      for (let j = i + 1; j < nodes.length; j++) {
        const other = nodes[j];
        const dist = Math.hypot(node.x - other.x, node.y - other.y);

        if (dist < 130) {
          ctx.beginPath();
          ctx.moveTo(node.x, node.y);
          // 90-degree trace simulation
          if (i % 2 === 0) {
            ctx.lineTo(other.x, node.y);
          } else {
            ctx.lineTo(node.x, other.y);
          }
          ctx.lineTo(other.x, other.y);
          ctx.stroke();
        }
      }
    }

    requestAnimationFrame(drawCircuit);
  }

  drawCircuit();

  /* ==========================================================================
     5. CUSTOM GLOWING CURSOR (DESKTOP)
     ========================================================================== */
  const cursorDot = document.getElementById('cursor-dot');
  const cursorRing = document.getElementById('cursor-ring');

  if (window.innerWidth > 992) {
    window.addEventListener('mousemove', (e) => {
      cursorDot.style.left = `${e.clientX}px`;
      cursorDot.style.top = `${e.clientY}px`;

      cursorRing.animate({
        left: `${e.clientX}px`,
        top: `${e.clientY}px`
      }, { duration: 500, fill: 'forwards' });
    });
  }

  /* ==========================================================================
     6. INTERSECTION OBSERVER (SCROLL ANIMATIONS & METRIC COUNTERS)
     ========================================================================== */
  const statCards = document.querySelectorAll('.stat-card');
  const skillItems = document.querySelectorAll('.skill-item');

  const observerOptions = { threshold: 0.3 };

  const statsObserver = new IntersectionObserver((entries, observer) => {
    entries.forEach(entry => {
      if (entry.isIntersecting) {
        const card = entry.target;
        const targetVal = parseInt(card.getAttribute('data-counter'), 10);
        const counterEl = card.querySelector('.counter-val');
        let current = 0;
        const increment = Math.ceil(targetVal / 30);

        const timer = setInterval(() => {
          current += increment;
          if (current >= targetVal) {
            counterEl.textContent = targetVal;
            clearInterval(timer);
          } else {
            counterEl.textContent = current;
          }
        }, 40);

        observer.unobserve(card);
      }
    });
  }, observerOptions);

  statCards.forEach(card => statsObserver.observe(card));

  const skillsObserver = new IntersectionObserver((entries, observer) => {
    entries.forEach(entry => {
      if (entry.isIntersecting) {
        const item = entry.target;
        const level = item.getAttribute('data-level');
        const progressBar = item.querySelector('.skill-progress');
        progressBar.style.width = `${level}%`;
        observer.unobserve(item);
      }
    });
  }, observerOptions);

  skillItems.forEach(item => skillsObserver.observe(item));

  /* Active Nav Link Highlighter on Scroll */
  const sections = document.querySelectorAll('section[id]');
  window.addEventListener('scroll', () => {
    const scrollY = window.scrollY;

    sections.forEach(current => {
      const sectionHeight = current.offsetHeight;
      const sectionTop = current.offsetTop - 120;
      const sectionId = current.getAttribute('id');

      if (scrollY > sectionTop && scrollY <= sectionTop + sectionHeight) {
        document.querySelectorAll('.nav-link').forEach(link => {
          link.classList.remove('active');
          if (link.getAttribute('href') === `#${sectionId}`) {
            link.classList.add('active');
          }
        });
      }
    });
  });

  /* ==========================================================================
     7. PROJECT DETAILS MODAL DATA & CONTROLLER
     ========================================================================== */
  const projectDetails = {
    project1: {
      title: "Smart Home Automation System",
      problem: "Traditional home systems lack low-latency, localized offline execution and security encryption across wireless nodes.",
      objective: "Build a modular, ESP32-based node controller supporting local web control and authenticated cloud synchronization.",
      components: ["ESP32 Dual-Core MCU", "4-Channel Solid State Relays", "DHT22 Sensor", "OLED Display", "Optocoupler Isolation"],
      circuit: "Optically isolated high-voltage relay triggers with dedicated flyback protection diodes and low-noise LDO power supply.",
      working: "Sensors stream telemetry over FreeRTOS priority tasks to an internal web server while posting JSON telemetry over TLS MQTT.",
      results: "Achieved sub-50ms reaction latency for offline automation triggers and zero power drop under full load."
    },
    project2: {
      title: "IoT Weather Telemetry Node",
      problem: "Remote environmental monitoring requires continuous battery operation and immunity to extreme temperature variations.",
      objective: "Engineered a solar-harvesting sensor platform transmitting telemetry over long distances with micro-amp sleep consumption.",
      components: ["ESP8266 Microcontroller", "BME280 Sensor", "LiFePO4 Solar Charger", "Deep Sleep RTC", "Custom PCB"],
      circuit: "Integrated MPPT power regulation circuit paired with reverse-polarity protection and low leakage FETs.",
      working: "The MCU wakes up every 15 minutes, samples temperature, humidity, and barometric pressure, posts to cloud dashboard, and returns to 15µA sleep.",
      results: "100% autonomous operation maintained over 6 months of outdoor field testing."
    },
    project3: {
      title: "Autonomous Obstacle Robot",
      problem: "Standard obstacle avoidance suffers from sensor lag and poor motor speed control on uneven surfaces.",
      objective: "Design a high-speed differential drive platform with hardware-based PWM control and ultrasonic collision avoidance.",
      components: ["ATmega328P MCU", "L298N Motor Driver", "HC-SR04 Sensors", "Quadrature Encoders", "LiPo Battery"],
      circuit: "Dedicated decoupling capacitors across DC motors with optical encoder signal filtering for clean quadrature feedback.",
      working: "A closed-loop PID control loop adjusts wheel PWM outputs in real-time using ultrasonic sensor vector feedback.",
      results: "Zero wall collisions recorded during dynamic maze testing at 1.2 m/s forward speed."
    },
    project4: {
      title: "Precision Benchtop Power Supply",
      problem: "Noisy bench power supplies cause erratic logic errors during sensitive analog schematic prototyping.",
      objective: "Architect a 4-layer low-ripple adjustable linear-switching hybrid DC power supply with micro-step precision.",
      components: ["STM32 Microcontroller", "Buck Converter IC", "Linear Regulator", "Current Shunt Amplifier", "128x64 OLED"],
      circuit: "Differential trace routing on current sensing lines with isolated digital and analog ground planes (star-ground layout).",
      working: "Dual-stage regulation: High efficiency Buck converter drops primary voltage, followed by a low-dropout linear regulator filtering voltage ripple.",
      results: "Delivered <5mV peak-to-peak output voltage ripple across full 0-30V / 5A range."
    }
  };

  const modalOverlay = document.getElementById('project-modal');
  const modalBody = document.getElementById('modal-body');
  const modalClose = document.getElementById('modal-close');

  document.querySelectorAll('.open-modal-btn').forEach(btn => {
    btn.addEventListener('click', (e) => {
      const card = e.target.closest('.project-card');
      const key = card.getAttribute('data-project');
      const data = projectDetails[key];

      if (data) {
        modalBody.innerHTML = `
          <div class="modal-section">
            <h2>${data.title}</h2>
          </div>
          <div class="modal-section">
            <h4>Problem Statement</h4>
            <p>${data.problem}</p>
          </div>
          <div class="modal-section">
            <h4>Objective</h4>
            <p>${data.objective}</p>
          </div>
          <div class="modal-section">
            <h4>Components Used</h4>
            <ul>${data.components.map(item => `<li>${item}</li>`).join('')}</ul>
          </div>
          <div class="modal-section">
            <h4>Circuit Design</h4>
            <p>${data.circuit}</p>
          </div>
          <div class="modal-section">
            <h4>Working Principle</h4>
            <p>${data.working}</p>
          </div>
          <div class="modal-section">
            <h4>Results & Metrics</h4>
            <p>${data.results}</p>
          </div>
        `;
        modalOverlay.classList.add('active');
        modalOverlay.setAttribute('aria-hidden', 'false');
      }
    });
  });

  modalClose.addEventListener('click', () => {
    modalOverlay.classList.remove('active');
    modalOverlay.setAttribute('aria-hidden', 'true');
  });

  modalOverlay.addEventListener('click', (e) => {
    if (e.target === modalOverlay) {
      modalOverlay.classList.remove('active');
      modalOverlay.setAttribute('aria-hidden', 'true');
    }
  });

  /* ==========================================================================
     8. CONTACT FORM VALIDATION
     ========================================================================== */
  const contactForm = document.getElementById('contact-form');
  const formFeedback = document.getElementById('form-feedback');

  contactForm.addEventListener('submit', (e) => {
    e.preventDefault();
    let isValid = true;

    const inputs = contactForm.querySelectorAll('.form-input');
    inputs.forEach(input => {
      const group = input.parentElement;
      if (!input.value.trim()) {
        group.classList.add('invalid');
        isValid = false;
      } else if (input.type === 'email' && !validateEmail(input.value)) {
        group.classList.add('invalid');
        isValid = false;
      } else {
        group.classList.remove('invalid');
      }
    });

    if (isValid) {
      formFeedback.style.color = 'var(--accent-teal)';
      formFeedback.textContent = '⚡ Message transmitted successfully! I will get back to you soon.';
      contactForm.reset();
      setTimeout(() => { formFeedback.textContent = ''; }, 5000);
    } else {
      formFeedback.style.color = '#ff4d4d';
      formFeedback.textContent = '⚠️ Please correct the errors above and re-send.';
    }
  });

  function validateEmail(email) {
    return /^[^\s@]+@[^\s@]+\.[^\s@]+$/.test(email);
  }
});
  </script>
</body>
</html>